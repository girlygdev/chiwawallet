# Copy to .env.local and fill in. Never commit real values.

# Supabase: Project Settings → API Keys / Data API.
# Use the base URL without /rest/v1. The publishable key is public by design (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: to keep `npm run dev` off the live database, put the same two
# NEXT_PUBLIC_ variables in a separate .env.development.local with the local
# Supabase values from `npx supabase status`. Next.js reads that file before
# .env.local for `next dev` only, so builds and Vercel still use live.
# Delete or rename it to test against live.

# Database tests only (npm run test:db), in a separate .env.test.local file.
# Local Supabase: run `npx supabase start`, then copy the API URL and the
# publishable key from `npx supabase status`. Never use the live project here.
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
